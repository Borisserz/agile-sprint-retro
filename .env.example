# Local npm (host): use localhost ports from docker compose db/mongo
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agile_sprint_retro
# For Neon/Supabase put the cloud URL here and set:
# DATABASE_SSL=true

JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173,http://localhost

# Lab 6 — MongoDB (Docker default; or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/agile_sprint_retro

# Lab 8 — frontend build (browser calls host-mapped API)
VITE_API_URL=http://localhost:3000

# Inside compose, backend overrides DATABASE_URL / MONGO_URI to service names db and mongo.
