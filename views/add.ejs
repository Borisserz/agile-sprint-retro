<%- include('partials/header') %>
<h1>Добавить спринт</h1>
<% if (typeof errors !== 'undefined' && errors.length) { %>
  <ul class="error">
    <% errors.forEach(function (item) { %>
      <li><%= item %></li>
    <% }) %>
  </ul>
<% } %>
<form method="post" action="/add?auth=1">
  <label>Название
    <input name="name" required maxlength="<%= limits.name %>" value="<%= typeof values !== 'undefined' ? values.name : '' %>" />
  </label>
  <label>Цель
    <input name="goal" required maxlength="<%= limits.goal %>" value="<%= typeof values !== 'undefined' ? values.goal : '' %>" />
  </label>
  <label>Ёмкость
    <input name="capacity" required inputmode="numeric" value="<%= typeof values !== 'undefined' ? values.capacity : '' %>" />
  </label>
  <label>Статус
    <select name="status">
      <% Object.keys(statuses).forEach(function (key) { %>
        <option value="<%= key %>" <%= typeof values !== 'undefined' && values.status === key ? 'selected' : '' %>><%= statuses[key] %></option>
      <% }) %>
    </select>
  </label>
  <label>Начало
    <input type="date" name="startDate" required value="<%= typeof values !== 'undefined' ? values.startDate : '' %>" />
  </label>
  <label>Окончание
    <input type="date" name="endDate" required value="<%= typeof values !== 'undefined' ? values.endDate : '' %>" />
  </label>
  <button type="submit">Сохранить</button>
</form>
<%- include('partials/footer') %>
