<%- include('partials/header') %>
<h1>Список спринтов</h1>
<table>
  <tr>
    <th>ID</th>
    <th>Название</th>
    <th>Цель</th>
    <th>Статус</th>
    <th></th>
  </tr>
  <% sprints.forEach(function (sprint) { %>
    <tr>
      <td><%= sprint.id %></td>
      <td><%= sprint.name %></td>
      <td><%= sprint.goal %></td>
      <td><%= sprint.status %></td>
      <td><a href="/item/<%= sprint.id %>?auth=1">Открыть</a></td>
    </tr>
  <% }) %>
</table>
<%- include('partials/footer') %>
